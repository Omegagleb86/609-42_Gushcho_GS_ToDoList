<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:models="clr-namespace:ToDoList.Models;assembly=ToDoList.Models" xmlns:vm="clr-namespace:ToDoList.ViewModels" xmlns:views="clr-namespace:ToDoList.Views"
 x:Class="ToDoList.MainPage" x:DataType="vm:MainViewModel" Title="Мои задачи"
 BackgroundColor="{AppThemeBinding Light=#F5F6FA, Dark=#14141C}">
 <ContentPage.Resources>
  <ResourceDictionary Source="Resources/Styles/TodoStyles.xaml" />
 </ContentPage.Resources>
 <ScrollView>
  <VerticalStackLayout Padding="20,24" Spacing="20" MaximumWidthRequest="760" HorizontalOptions="Fill">
   <Label Text="Мои задачи" FontSize="32" FontAttributes="Bold" />
   <Border IsEnabled="{Binding HasLoaded}">
    <VerticalStackLayout Spacing="12">
     <Label Text="Новая задача" Style="{StaticResource SectionTitle}" />
     <Grid ColumnDefinitions="*,48" ColumnSpacing="6">
      <Entry Text="{Binding NewTaskTitle}" Placeholder="Что нужно сделать?" MinimumWidthRequest="0" ReturnCommand="{Binding AddTaskCommand}" />
      <ImageButton Grid.Column="1" Source="add.png" Command="{Binding AddTaskCommand}" SemanticProperties.Description="Добавить задачу" />
     </Grid>
     <Picker Title="Без категории" ItemsSource="{Binding Categories}" ItemDisplayBinding="{Binding Name, x:DataType=models:Category}" SelectedItem="{Binding SelectedCategory}" />
    </VerticalStackLayout>
   </Border>
   <Border IsEnabled="{Binding HasLoaded}">
    <VerticalStackLayout Spacing="12">
     <Label Text="Категории" Style="{StaticResource SectionTitle}" />
     <Grid ColumnDefinitions="*,48" ColumnSpacing="6">
      <Entry Text="{Binding NewCategoryName}" Placeholder="Название категории" MinimumWidthRequest="0" ReturnCommand="{Binding AddCategoryCommand}" />
      <ImageButton Grid.Column="1" Source="add.png" Command="{Binding AddCategoryCommand}" SemanticProperties.Description="Создать категорию" />
     </Grid>
     <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding CategoryItems}">
      <BindableLayout.EmptyView><Label Text="Категорий пока нет." FontSize="13" /></BindableLayout.EmptyView>
      <BindableLayout.ItemTemplate>
       <DataTemplate x:DataType="vm:CategoryViewModel">
        <Grid ColumnDefinitions="*,48" ColumnSpacing="6">
         <Label Text="{Binding Name}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
         <ImageButton Grid.Column="1" Source="delete.png" Style="{StaticResource DeleteButton}"
          Command="{Binding DeleteCommand}" ToolTipProperties.Text="Удалить категорию"
          SemanticProperties.Description="{Binding Name, StringFormat='Удалить категорию {0}'}" />
        </Grid>
       </DataTemplate>
      </BindableLayout.ItemTemplate>
     </VerticalStackLayout>
    </VerticalStackLayout>
   </Border>
   <Label Text="{Binding Message}" TextColor="{AppThemeBinding Light=#A12B43, Dark=#FFB0C0}" />
   <ImageButton Source="retry.png" Command="{Binding SaveCommand}" IsVisible="{Binding HasMessage}"
    ToolTipProperties.Text="Повторить загрузку или сохранение" SemanticProperties.Description="Повторить загрузку или сохранение" />
   <Label Text="Список задач" Style="{StaticResource SectionTitle}" />
   <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Tasks}">
    <BindableLayout.EmptyView><Label Text="Задач пока нет. Добавьте первую задачу выше." /></BindableLayout.EmptyView>
    <BindableLayout.ItemTemplate>
     <DataTemplate x:DataType="vm:TaskViewModel"><views:TaskItemView /></DataTemplate>
    </BindableLayout.ItemTemplate>
   </VerticalStackLayout>
  </VerticalStackLayout>
 </ScrollView>
</ContentPage>
